# Copy to .env and fill in. irp reads .env from the directory you start it in;
# variables already set in your environment win.

# TypeSafe API key for Jev (TYPESAFE_API_KEY works too). Without it, presets are
# stripped and stored but never served.
JEV_SECRET=

# Optional overrides (defaults shown)
# IRP_PORT=18766
# IRP_MATCH_MODE=live
# IRP_JEV_TIMEOUT_MS=800
# IRP_HIDDEN_MEMORY=true
# IRP_TRAFFIC_LOG=false
